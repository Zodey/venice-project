void Decoration()
{
	auto draw = ImGui::GetWindowDrawList();
	ImVec2 pos = ImGui::GetWindowPos();
	const float side = 148.f;
	const float bar = menu_h - 64.f;

	draw->AddRectFilled(ImVec2(pos.x, pos.y), ImVec2(pos.x + side, pos.y + menu_h), ImColor(32, 32, 32, int(255 * ImGui::GetStyle().Alpha)), 10, ImDrawFlags_RoundCornersLeft);
	draw->AddRect(ImVec2(pos.x, pos.y), ImVec2(pos.x + side, pos.y + menu_h), ImColor(50, 50, 50, int(255 * ImGui::GetStyle().Alpha)), 10, ImDrawFlags_RoundCornersLeft, 1);

	draw->AddRectFilled(ImVec2(pos.x + side - 1, pos.y), ImVec2(pos.x + menu_w, pos.y + menu_h), ImColor(26, 26, 26, int(255 * ImGui::GetStyle().Alpha)), 10, ImDrawFlags_RoundCornersRight);
	draw->AddRect(ImVec2(pos.x + side - 1, pos.y), ImVec2(pos.x + menu_w, pos.y + menu_h), ImColor(50, 50, 50, int(255 * ImGui::GetStyle().Alpha)), 10, ImDrawFlags_RoundCornersRight, 1);

	draw->AddRectFilled(ImVec2(pos.x + side - 1, pos.y + bar), ImVec2(pos.x + menu_w, pos.y + menu_h), ImColor(30, 30, 30, int(255 * ImGui::GetStyle().Alpha)), 10, ImDrawFlags_RoundCornersBottomRight);
	draw->AddLine(ImVec2(pos.x + side, pos.y + 40), ImVec2(pos.x + menu_w - 10, pos.y + 40), ImColor(44, 44, 44, int(255 * ImGui::GetStyle().Alpha)));
	draw->AddLine(ImVec2(pos.x + side, pos.y + bar), ImVec2(pos.x + menu_w - 10, pos.y + bar), ImColor(44, 44, 44, int(255 * ImGui::GetStyle().Alpha)));

	draw->AddRectFilled(ImVec2(pos.x + 700, pos.y + 10), ImVec2(pos.x + 852, pos.y + 30), ImColor(34, 34, 34, int(255 * ImGui::GetStyle().Alpha)), 4, ImDrawFlags_RoundCornersAll);
	draw->AddRect(ImVec2(pos.x + 700, pos.y + 10), ImVec2(pos.x + 852, pos.y + 30), ImColor(46, 46, 46, int(255 * ImGui::GetStyle().Alpha)), 4, ImDrawFlags_RoundCornersAll, 1);

	ImGui::SetCursorPos(ImVec2(18, 20));
	ImGui::Image((ImTextureID)logo, ImVec2(112, 24));

	ImGui::SetCursorPos(ImVec2(32, -6));
